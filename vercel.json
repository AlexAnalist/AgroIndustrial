{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "main.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/backend/:path*"
        },
        {
            "source": "/:path*",
            "destination": "/frontend/:path*"
        }
    ]
}